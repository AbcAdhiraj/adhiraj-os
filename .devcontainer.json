{
  "name": "adhiraj-os",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "adhiraj-os",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    },
    "codespaces": {
      "openFiles": [
        "data.js",
        "README.md"
      ]
    }
  },
  "postStartCommand": "nohup bash -c 'python3 -m http.server 8080 &' > /tmp/server.log 2>&1"
}